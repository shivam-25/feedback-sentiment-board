# Frontend (Vite) — these are compiled into the browser bundle and are safe to expose.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# NOT set here. The Gemini key lives ONLY as a Supabase Edge Function secret:
#   supabase secrets set GEMINI_API_KEY=...
# It must never appear in this file or in any VITE_* variable, because every
# VITE_* value is inlined into the public client bundle.
